<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Plantilla A4: 3 etiquetas por fila en hoja A4.
            El AbstractModel ya entrega 'docs' expandido (una entrada por unidad).
        -->
        <template id="report_label_pagination">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="line">
                        <div style="display: inline-table; height: 10rem; width: 32%; margin: 0.2%; vertical-align: top;">
                            <table style="border: 2px solid black; width: 100%; height: 100%; border-collapse: collapse; page-break-inside: avoid;">
                                <!-- Nombre del producto -->
                                <tr>
                                    <th style="background: #e9ecef; text-align: left; padding: 4px; font-size: 7.5pt; height: 3rem; vertical-align: middle;">
                                        <span t-out="line.product_id.display_name"/>
                                    </th>
                                </tr>
                                <!-- Código de barras: lote > barcode de producto > sin código -->
                                <tr>
                                    <td style="text-align: center; vertical-align: middle; height: 5rem; padding: 2px;">
                                        <t t-if="line.lot_id">
                                            <div t-field="line.lot_id.name"
                                                 t-options="{'widget': 'barcode', 'width': 600, 'height': 80, 'img_style': 'width:100%;height:2.5rem'}"/>
                                            <small t-out="line.lot_id.name" style="font-size: 6pt;"/>
                                        </t>
                                        <t t-elif="line.product_id.barcode">
                                            <div t-field="line.product_id.barcode"
                                                 t-options="{'widget': 'barcode', 'width': 600, 'height': 80, 'img_style': 'width:100%;height:2.5rem'}"/>
                                            <small t-out="line.product_id.barcode" style="font-size: 6pt;"/>
                                        </t>
                                        <t t-else="">
                                            <span style="font-size: 7pt; color: #6c757d;">Sin código de barras</span>
                                        </t>
                                    </td>
                                </tr>
                                <!-- Referencia de transferencia -->
                                <tr>
                                    <td style="text-align: center; font-size: 6.5pt; padding: 2px; border-top: 1px solid #dee2e6;">
                                        <t t-if="line.picking_id">
                                            <t t-out="line.picking_id.name"/>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <!--
            Plantilla Dymo: wrapper idéntico a product.report_productlabel_dymo
            pero iterando sobre `docs` (stock.move.line) en lugar de quantity.items().
            pricelist viene del AbstractModel ReportLabelDymo._get_report_values.
            Delega cada etiqueta a la sub-plantilla nativa product.report_simple_label_dymo.
        -->
        <template id="report_label_dymo">
            <t t-call="web.html_container">
                <t t-set="barcode_size" t-value="'width:45.5mm;height:7.5mm'"/>
                <t t-set="table_style"  t-value="'width:100%;height:32mm;'"/>
                <t t-set="padding_page" t-value="'padding: 2mm'"/>
                <t t-foreach="docs" t-as="line">
                    <t t-set="barcode"  t-value="line.lot_id.name if line.lot_id else line.product_id.barcode"/>
                    <t t-set="product"  t-value="line.product_id.with_context(display_default_code=False)"/>
                    <t t-call="product.report_simple_label_dymo"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
