<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="pos_order_form_inherit_translated_name" model="ir.ui.view">
    <field name="name">pos.order.form.inherit.translated.name</field>
    <field name="model">pos.order</field>
    <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lines']//list/field[@name='full_product_name']" position="after">
        <field name="translated_product_name" column_invisible="True"/>
      </xpath>
    </field>
  </record>
</odoo>
