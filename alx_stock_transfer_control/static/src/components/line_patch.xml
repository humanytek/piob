<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!--
        Hide the -1 / +1 / +N scan buttons for non-admin users.
        env.model.groups.user_can_edit_qty is injected by our get_barcode_data
        controller override (True only for group_stock_inventory_admin).

        Each t-if replaces the original condition, keeping the original logic
        and appending the admin check.
    -->
    <t t-inherit="stock_barcode.LineLowerButtons" t-inherit-mode="extension">

        <xpath expr="//button[@name='decrementButton']" position="attributes">
            <attribute name="t-if">isSelected &amp;&amp; qtyDone &amp;&amp; !isPackage &amp;&amp; env.model.groups.user_can_edit_qty</attribute>
        </xpath>

        <xpath expr="//button[@name='incrementButton']" position="attributes">
            <attribute name="t-if">displayIncrementButton &amp;&amp; env.model.groups.user_can_edit_qty</attribute>
        </xpath>

        <xpath expr="//button[@name='fulfillButton']" position="attributes">
            <attribute name="t-if">displayFulfillbutton &amp;&amp; env.model.groups.user_can_edit_qty</attribute>
        </xpath>

    </t>
</templates>
