<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Operator: restricted to their allowed warehouses (location_id or location_dest_id).
            Because Supervisor/Admin imply Operator via implied_ids, they also get this rule.
            But their open rules (1=1) unify with it, so they see everything.
        -->
        <record id="stock_picking_rule_operator" model="ir.rule">
            <field name="name">Stock Picking - Operador (Almacenes Permitidos)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('alx_stock_transfer_control.group_stock_operator'))]"/>
            <field name="domain_force">
                ['|',
                 ('location_id.warehouse_id', 'in', user.allowed_warehouse_ids.ids),
                 ('location_dest_id.warehouse_id', 'in', user.allowed_warehouse_ids.ids)]
            </field>
        </record>

        <!-- Supervisor: open rule - sees ALL pickings regardless of warehouse -->
        <record id="stock_picking_rule_supervisor" model="ir.rule">
            <field name="name">Stock Picking - Supervisor Logístico (Todos)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('alx_stock_transfer_control.group_stock_logistics_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Admin: open rule - sees ALL pickings -->
        <record id="stock_picking_rule_admin" model="ir.rule">
            <field name="name">Stock Picking - Administrador Inventario (Todos)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('alx_stock_transfer_control.group_stock_inventory_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
