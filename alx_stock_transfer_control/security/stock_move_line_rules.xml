<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Operator: restricted to allowed warehouses on move lines -->
        <record id="stock_move_line_rule_operator" model="ir.rule">
            <field name="name">Stock Move Line - Operador (Almacenes Permitidos)</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="groups" eval="[(4, ref('alx_stock_transfer_control.group_stock_operator'))]"/>
            <field name="domain_force">
                ['|',
                 ('location_id.warehouse_id', 'in', user.allowed_warehouse_ids.ids),
                 ('location_dest_id.warehouse_id', 'in', user.allowed_warehouse_ids.ids)]
            </field>
        </record>

        <!-- Supervisor: open rule - sees all move lines -->
        <record id="stock_move_line_rule_supervisor" model="ir.rule">
            <field name="name">Stock Move Line - Supervisor Logístico (Todos)</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="groups" eval="[(4, ref('alx_stock_transfer_control.group_stock_logistics_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Admin: open rule - sees all move lines -->
        <record id="stock_move_line_rule_admin" model="ir.rule">
            <field name="name">Stock Move Line - Administrador de Transferencias de Inventario (Todos)</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="groups" eval="[(4, ref('alx_stock_transfer_control.group_stock_inventory_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
